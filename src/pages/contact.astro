---
export const prerender = true;
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>
  TotalSportek Contact | Questions, Suggestions & Visitor Support
</title>

<meta
  name="description"
  content="Reach TotalSportek for website questions, visitor comments, suggestions, or general inquiries. Contact us about sports content, schedules, site features, event information, and other matters related to TotalSportek."
/>

<meta
  name="keywords"
  content="TotalSportek contact page, contact TotalSportek, TotalSportek inquiries, TotalSportek visitor support, TotalSportek suggestions, TotalSportek comments, TotalSportek website questions, TotalSportek assistance, sports site inquiries, sports information questions, TotalSportek communication"
/>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700&family=Roboto+Condensed:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[#09090f]">
    <header class="bg-[#131320] border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4">
        <div class="h-16 flex items-center justify-between gap-4">
          <a
            href="/"
            class="text-2xl font-bold text-[#f9fafb] hover:text-purple-400 transition whitespace-nowrap"
          >
            TotalSportek
          </a>
        </div>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-4 mt-15 text-start">
      <h1 class="text-3xl sm:text-4xl font-bold mb-6 text-[#f9fafb]">
        Contact Us
      </h1>

      <a
        href="mailto:support@methstreams736.cfd"
        class="text-[#c084fc] text-base sm:text-lg font-semibold transition break-all"
      >
        support@buffStreamstv.cfd
      </a>
    </div>
  </body>
</html>