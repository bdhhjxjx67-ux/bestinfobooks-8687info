---
import "../styles/global.css";

export const prerender = false;

type Match = {
  MatchID: string;
  League: string;
  LeagueLogo: string;
  Team1: string;
  Team1Logo: string;
  Team2: string;
  Team2Logo: string;
  Date: string;
  Time: string;
  TVGuide?: string;
  MatchThumb?: string;
  IframeURL: string;
};

const res = await fetch(
  "https://opensheet.elk.sh/1gHshryM9mQFVYC2AeSj6bhcKW8_g69EBbMPI0F8s53Y/1",
);

function slugify(text: string) {
  return text
    .toLowerCase()
    .trim()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

const data = await res.json();

const matches: Match[] = Array.isArray(data)
  ? data
  : data.matches || data.data || [];

const groupedMatches: Record<string, Match[]> = matches.reduce(
  (acc: Record<string, Match[]>, match: Match) => {
    const league = match.League || "Other";

    if (!acc[league]) {
      acc[league] = [];
    }

    acc[league].push(match);

    return acc;
  },
  {},
);
